# ─────────────────────────────────────────────────────
# ISC WORKS PROJE1 — .env Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin
# cp .env.example .env
# ─────────────────────────────────────────────────────

# Sunucu Portu
PORT=3000

# ─── Meta / Instagram Webhook ───────────────────────
FB_VERIFY_TOKEN=your_verify_token
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FB_API_VERSION=v21.0
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# ─── OpenAI ─────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# ─── Telegram Bildirimleri ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── n8n Webhook ────────────────────────────────────
N8N_WEBHOOK_URL=your_n8n_webhook_url

# ─── Veritabanı ─────────────────────────────────────
DB_NAME=app.db

# ─── AI Message Buffer (Debounce) ───────────────────
# Kullanıcı hızlı arka arkaya mesaj gönderdiğinde
# kaç ms beklensin? (Default: 1500ms)
AI_MESSAGE_BUFFER_MS=1500
